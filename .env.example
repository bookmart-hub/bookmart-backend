# Django Core Settings
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Credentials (PostgreSQL default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bookmart_db
DB_USER=bookmart_user
DB_PASSWORD=bookmart_password
DB_HOST=127.0.0.1
DB_PORT=5432

# SMTP Mail Credentials (for OTP delivery)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Storage Settings
STORAGE_PROVIDER=local  # Options: local, cloudinary, s3

# Social Auth Credentials
GOOGLE_CLIENT_IDS=your-android-client-id,your-ios-client-id,your-web-client-id
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
